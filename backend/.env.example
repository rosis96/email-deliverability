APP_NAME="RevCadence Deliverability OS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# --- PostgreSQL (matches docker-compose db service) ---
DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=revcadence
DB_USERNAME=revcadence
DB_PASSWORD=change-me-in-production

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database

# --- Sanctum (SPA + token auth) ---
SANCTUM_STATEFUL_DOMAINS=localhost:3000,127.0.0.1:3000
FRONTEND_URL=http://localhost:3000

MAIL_MAILER=log
MAIL_FROM_ADDRESS="ops@revcadence.local"
MAIL_FROM_NAME="${APP_NAME}"

# --- Integration credentials (server-side only; never exposed to browser) ---
INSTANTLY_API_KEY=
MAILDOSO_API_KEY=
GOOGLE_POSTMASTER_CREDENTIALS=
MICROSOFT_SNDS_KEY=
MXTOOLBOX_API_KEY=
