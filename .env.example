# ---------------------------------------------------------------------------
# Docker Compose environment (host-level). Copy to `.env` before running
# `docker compose up`. The backend reads its own backend/.env; these values
# here are only for compose variable substitution + the Postgres container.
# ---------------------------------------------------------------------------

# PostgreSQL (must match backend/.env DB_* values)
DB_DATABASE=revcadence
DB_USERNAME=revcadence
DB_PASSWORD=change-me-in-production
DB_PORT=5432

# Exposed host ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Frontend -> API base URL (as seen from the browser)
NEXT_PUBLIC_API_URL=http://localhost:8000/api
